rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Reusable Global Security Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Connection Liveness / Health Check ---
    match /test/{docId} {
      allow read, write: if true;
    }

    // --- Matches per Collection ---

    match /users/{username} {
      allow read, write: if true;
    }

    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /subscriptionPlans/{id} {
      allow read, write: if true;
    }

    match /userSubscriptions/{id} {
      allow read, write: if true;
    }

    match /serviceTemplates/{id} {
      allow read, write: if true;
    }

    match /serviceRequests/{id} {
      allow read, write: if true;
    }

    match /notifications/{id} {
      allow read, write: if true;
    }

    match /locationHistory/{id} {
      allow read, write: if true;
    }

    match /miscSpends/{id} {
      allow read, write: if true;
    }

    match /bookkeeping/{id} {
      allow read, write: if true;
    }

    match /profitLoss/{id} {
      allow read, write: if true;
    }

    match /spendCategories/{id} {
      allow read, write: if true;
    }

    match /predefinedCosts/{id} {
      allow read, write: if true;
    }

    match /vehicleData/{id} {
      allow read, write: if true;
    }

    match /tyreData/{id} {
      allow read, write: if true;
    }

    match /pricingConfig/{id} {
      allow read, write: if true;
    }

    match /predefinedServiceCategories/{id} {
      allow read, write: if true;
    }

    match /predefinedServices/{id} {
      allow read, write: if true;
    }

    match /deliveryHubs/{id} {
      allow read, write: if true;
    }

    match /productRules/{id} {
      allow read, write: if true;
    }

    match /customers/{id} {
      allow read, write: if true;
    }

    match /inventoryItems/{id} {
      allow read, write: if true;
    }

    match /inventoryMovements/{id} {
      allow read, write: if true;
    }

    match /expenses/{id} {
      allow read, write: if true;
    }

    match /recurringExpenses/{id} {
      allow read, write: if true;
    }

    match /auditLogs/{id} {
      allow read, write: if true;
    }

    match /warranties/{id} {
      allow read, write: if true;
    }

    match /retentionLogs/{id} {
      allow read, write: if true;
    }

    match /erpVehicles/{id} {
      allow read, write: if true;
    }

    match /erpSuppliers/{id} {
      allow read, write: if true;
    }

    match /erpPurchaseOrders/{id} {
      allow read, write: if true;
    }

    match /erpServiceRecipes/{id} {
      allow read, write: if true;
    }

    match /erpSalesDocuments/{id} {
      allow read, write: if true;
    }

    match /erpAccountBalances/{id} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;
    }
  }
}

