# Ignore node_modules & package build caches
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Ignore Git
.git
.gitignore

# Ignore local environment secrets (never bake secrets into Docker images!)
.env
.env.local
.env.*.local

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore build artifacts (will be generated cleanly in the builder stage)
dist
coverage

# Ignore mobile builds & android platform
android
.gradle
