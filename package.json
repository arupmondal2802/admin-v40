{
  "name": "a-big-engine-service-app",
  "version": "1.0.0",
  "private": true,
  "description": "A multi-step, dynamic form for service agents to log new service requests for customers, including customer details, service selection, add-ons, and invoice generation.admin dashboard,order creation ,lifecycle mangement,end to end data sync, subscription management,add on management,dynamic service form creation",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:worker": "esbuild worker.ts --bundle --platform=neutral --target=es2022 --format=esm --external:@neondatabase/serverless --banner:js=\"// @ts-nocheck\" --outfile=cloudflare-worker/worker.js",
    "deploy:worker": "wrangler deploy",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "test": "vitest run",
    "cap:add": "cap add android",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "cap:build": "vite build && cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@google/genai": "^0.14.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sendgrid/mail": "^8.1.6",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@vitejs/plugin-react": "^5.1.4",
    "dexie": "^4.4.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.16.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.469.0",
    "motion": "^13.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@types/google.maps": "^3.65.2",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.151.1"
  }
}
