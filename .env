# =============================================================
# A BIG ENGINE - ACTIVE ENVIRONMENT CONFIGURATION (.env)
# =============================================================

# --- Server & Deployment Configuration ---
# Render dynamically passes PORT; default is 3000 for local development.
PORT=3000
NODE_ENV=development

# Cloudflare Workers Edge Backend URL (empty by default to use relative same-origin Node.js Express server)
VITE_CLOUDFLARE_WORKER_URL=
VITE_BACKEND_URL=

# --- Database (Neon PostgreSQL) ---
# High-performance serverless PostgreSQL connection string
DATABASE_URL=postgresql://neondb_owner:npg_SYCptsnG2r9U@ep-sparkling-fire-ayctdt0t-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Google Gemini AI ---
# API Key for vehicle service assistant & automated service record summaries
GEMINI_API_KEY=

# --- Google Maps Platform ---
# API key for customer address autocompletion & place details
GOOGLE_MAPS_PLATFORM_KEY=

# --- Transactional Email (SendGrid) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@abigengine.com

# --- SMS Gateway (MSG91) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=ABGENG

# --- Web Push Notifications (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@abigengine.com

# --- Google Apps Script (Sheets Sync Fallback) ---
GOOGLE_SHEETS_URL=
