# -------------------------------------------------------------
# A BIG ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE
# -------------------------------------------------------------

# --- Server & Deployment Configuration ---
PORT=3000
NODE_ENV=development

# Cloudflare Workers JS or Custom Edge Backend URL (used by Vite frontend & mobile app)
# Leave empty to use relative same-origin /api routes, or set to your worker: https://a-big-engine-backend.<subdomain>.workers.dev
VITE_CLOUDFLARE_WORKER_URL=
VITE_BACKEND_URL=

# --- Database (Neon PostgreSQL) ---
# Connection string from Neon Console (Pooler connection recommended)
DATABASE_URL=postgresql://neondb_owner:npg_SYCptsnG2r9U@ep-sparkling-fire-ayctdt0t-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- AI & Cloud Services ---
# Google Gemini API key for smart chatbot and automated summaries
GEMINI_API_KEY=

# Google Maps Platform Key (for address autocompletion & geocoding)
GOOGLE_MAPS_PLATFORM_KEY=

# --- Notifications & Communication ---
# SendGrid Email Service
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@abigengine.com

# MSG91 SMS Service
MSG91_AUTH_KEY=
MSG91_SENDER_ID=ABGENG

# Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@abigengine.com

# --- Google Sheets Integration ---
# Default Google Apps Script Web App URL for data synchronization fallback
GOOGLE_SHEETS_URL=

